        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All-in-one is a complete meal on its own, like a pasta dish or a sandwich. The others are served together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plato único es una comida completa por sí sola, como una pasta o un sándwich. Los demás se sirven juntos."
