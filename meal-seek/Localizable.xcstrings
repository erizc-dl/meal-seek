    "Best-effort filtering, not a medical guarantee. Always check labels." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best-effort filtering, not a medical guarantee. Always check labels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrado en la medida de lo posible, sin garantía médica. Revisa siempre las etiquetas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽力筛除，但不构成医学保证。请务必查看食品标签。"
          }
        }
      }
    },
